<mah:MetroWindow x:Class="MediaFaceSearcher.Views.AddingPersonView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediaFaceSearcher.Views"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Збереження персони" Height="400" Width="600">
    <Grid>
        <Grid ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="1" Margin="20" ShowGridLines="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Content="Ім'я" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label Grid.Column="0" Grid.Row="1" Content="Емоція" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <TextBox Grid.Column="1" Grid.Row="0" FontSize="24" Width="170" Height="40" Text="Дмитро" IsEnabled="False"/>
                <ComboBox Grid.Column="1" Grid.Row="1" FontSize="24" Width="170" Height="40">
                    <ComboBox.Items>
                        Нейтрально
                    </ComboBox.Items>
                </ComboBox>
                <CheckBox  Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Content="Зберегти копію фото" FontSize="24" 
                           VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" FlowDirection="RightToLeft"/>
                <CheckBox  Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Content="'Додати фото до 'Дмитро" FontSize="24" 
                           VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" FlowDirection="RightToLeft"/>

                <Button Grid.Row="4" Grid.Column="1" Margin="10" Content="Наступне фото"/>
            </Grid>

            <Image Grid.Row="0" Grid.Column="0" Source="C:/Users/rosse/Downloads/foo.jpg" Width="150"/>
        </Grid>
    </Grid>
</mah:MetroWindow>
